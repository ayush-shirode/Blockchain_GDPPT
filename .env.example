# Database connection URL (SQLite local demo, compatible with PostgreSQL)
DATABASE_URL="file:./dev.db"

# Session cookie encryption/signing secret (min 32 characters)
SESSION_SECRET="demo-super-secret-session-key-32chars-min-change-in-prod"

# Local directory for demo Ed25519 issuer signing keys (git-ignored)
KEYS_DIR="./.keys"

# Ledger Adapter Mode: "simulated" (default) or "fabric"
LEDGER_MODE="simulated"

# Node environment
NODE_ENV="development"
